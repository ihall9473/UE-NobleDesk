# Copy this file to .env.local for local testing, and enter the same values
# into Vercel's "Environment Variables" settings when you deploy.

# From your Supabase project (Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The secret code coworkers need, alongside your invite link, to create
# their own account. Change this to something only your team knows.
APP_INVITE_CODE=choose-a-code-here

# Push notifications (for "you have a new text" alerts on installed devices).
# These keys were generated specifically for this project - keep them as-is,
# or generate your own with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BHAifK4jr40Tnu8g3D4FsysrvkPYJIud9_LJjMZWWvBfIlfH8sTA-5Q8u6diuiVwPSn3u-9LvbvWFl4pdiLvSJs
VAPID_PRIVATE_KEY=k-txctxvz-vGwfiN-fz-fRooOqAKVp6qEuu5DAGbTi4

# Your site's own address once deployed, e.g. https://your-app.vercel.app
# Used so newly-purchased numbers automatically point back at your webhook.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Encrypts SSN and bank account/routing numbers before they're stored.
# This key was generated specifically for this project - keep it exactly as
# is, and keep it secret (don't commit it anywhere public). If you ever need
# a new one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if you change this key after client data already exists, any
# previously-saved SSN/bank numbers become unreadable - back up first.
ENCRYPTION_KEY=3a2e398bc4ea28999f3bb56347a4c334f126e125165e00917d568c5cfb571a34
